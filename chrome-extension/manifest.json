{
  "manifest_version": 3,
  "name": "100x job Copilot",
  "version": "1.0.4",
  "description": "Auto-apply and job scraping copilot for 100x job.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "http://localhost:3004/*",
    "https://2captcha.com/*",
    "https://*.2captcha.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.seek.com.au/*",
        "*://*.indeed.com/*",
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.ashbyhq.com/*",
        "*://*/*/careers/*",
        "*://*/*/careers",
        "*://*/*/jobs/*",
        "*://*/*/job/*",
        "*://*/*/positions/*",
        "*://*/*/opportunities/*",
        "*://*/*/apply/*",
        "*://*/*/application/*",
        "*://*.workday.com/*",
        "*://*.myworkdayjobs.com/*",
        "*://*.bamboohr.com/*",
        "*://*.workable.com/*",
        "*://*.smartrecruiters.com/*",
        "*://zedai.dev/*"
      ],
      "js": ["content.js"],
      "css": ["copilot.css"],
      "all_frames": false
    }
  ]
}
