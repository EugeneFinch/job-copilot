{
  "manifest_version": 3,
  "name": "100x job Copilot",
  "version": "1.0.2",
  "description": "Auto-apply and job scraping copilot for 100x job.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "http://localhost:3004/*",
    "https://2captcha.com/*",
    "https://*.2captcha.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["copilot.css"],
      "all_frames": true
    }
  ]
}
