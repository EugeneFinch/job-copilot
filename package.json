{
  "name": "job-copilot",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "job-copilot": "bin/cli.js",
    "job-search": "bin/cli.js"
  },
  "scripts": {
    "start": "node bin/cli.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node --watch server.js",
    "client": "vite",
    "build": "vite build && node scripts/package-extension.js",
    "prepublishOnly": "npm run build",
    "package:extension": "node scripts/package-extension.js",
    "preview": "vite preview",
    "postinstall": "npx playwright install chromium",
    "server:persist-install": "node scripts/manage-daemon.js install",
    "server:persist-uninstall": "node scripts/manage-daemon.js uninstall",
    "server:persist-status": "node scripts/manage-daemon.js status",
    "server:persist-restart": "node scripts/manage-daemon.js restart",
    "server:persist-logs": "tail -n 100 -f logs/server.log",
    "server:persist-errors": "tail -n 100 -f logs/server-error.log"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "lucide-react": "^0.395.0",
    "multer": "^2.1.1",
    "playwright": "^1.44.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "vite": "^5.3.1"
  },
  "files": [
    "bin",
    "dist",
    "scripts",
    "chrome-extension",
    "server.js"
  ]
}
